      <aliases enabled='yes' />
      <column caption='Star Mass' datatype='real' name='[Calculation_0414257736749057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[orbital_radius]^3 / [orbital_period]^2' />
      </column>
      <column caption='Star Luminosity' datatype='real' name='[Calculation_0414257736945667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0414257736749057]^3.5' />
      </column>
      <column caption='T_eq (K)' datatype='real' name='[Calculation_0414257737187332]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='278.3 * [Calculation_0414257736945667]^0.25 * (1/[orbital_radius])^0.5 * (1-0)^0.25' />
      </column>
      <column caption='T_eq (°C)' datatype='real' name='[Calculation_0414257737797637]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0414257737187332] - 273.15' />
      </column>
